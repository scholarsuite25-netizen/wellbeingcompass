# Wellbeing Compass — Environment Variables
# Copy to .env and fill required values. See lib/env.ts for validation.
# ───────────────────────────────────────────────────────────────────
# All variables are documented here. NEVER commit .env with secrets.

# ── Site ──────────────────────────────────────────────────────────
# Public URL used for metadata, sitemap, OG, canonicals, emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Wellbeing Compass
# In production: https://wellbeingcompass.org

# ── Database & Supabase ───────────────────────────────────────────
# Vercel + Supabase/Neon (PostgreSQL) — REQUIRED for production (Vercel filesystem is ephemeral, SQLite won't persist)
# Get from Supabase: Project Settings → Database → Connection string → URI (pooler, port 6543 for pgbouncer)
# Example: DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# For local dev you can use SQLite (zero-config) OR same Supabase URL:
# SQLite: DATABASE_URL=file:./dev.db  (requires prisma/schema.prisma provider = "sqlite" — see comment in schema.prisma)
# Postgres local: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wellbeing
DATABASE_URL=file:./dev.db
DIRECT_URL=file:./dev.db
# Vercel: set DATABASE_URL + DIRECT_URL in Vercel Dashboard → Settings → Environment Variables → Production = postgresql://...
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true  (pooler, for app)
# DIRECT_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres  (direct, for migrations, no pgbouncer)

# Optional Supabase Client Keys (Settings -> API):
# NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Auth (NextAuth / Auth.js v4) ──────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# In production (Vercel): set to https://your-domain.com
# If you use Vercel preview deployments, you can leave NEXTAUTH_URL unset — it auto-infers from VERCEL_URL (https://xxx.vercel.app)
# Vercel Dashboard → Settings → Environment Variables → Add NEXTAUTH_URL for Production + Preview
NEXTAUTH_SECRET=change-me-to-a-strong-random-string-32chars-min
# Generate: openssl rand -base64 32  (must be 32+ chars, same for Preview & Production)

# ── Media storage ─────────────────────────────────────────────────
# local = filesystem (dev), s3 = AWS S3, r2 = Cloudflare R2
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_BUCKET=wellbeing-compass-media
# Only needed when MEDIA_STORAGE_PROVIDER=s3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=wellbeing-compass-media

# ── Email ─────────────────────────────────────────────────────────
# console = log to server console (dev), resend = Resend API (prod)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@wellbeingcompass.org
CONTACT_TO_EMAIL=hello@wellbeingcompass.org
# Only needed when EMAIL_PROVIDER=resend:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ── Analytics (privacy-conscious) ─────────────────────────────────
# none | plausible | ga . Plausible is recommended for health content.
ANALYTICS_PROVIDER=none
ANALYTICS_DOMAIN=wellbeingcompass.org
# Google Analytics measurement ID (format G-XXXXXX). Leave empty to disable GA.
# Set NEXT_PUBLIC_GA_ID in Vercel env for client-side GA + in .env for local.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Contact & Hotline (click-to-call / WhatsApp) ──────────────────
# Control the click-to-call and WhatsApp buttons. International format with country code.
CONTACT_PHONE=+2348146620168

# ── Member notifications (optional) ───────────────────────────────
# Resend is used for transactional email already (EMAIL_PROVIDER).
# WhatsApp Business API (Cloud API) — set these to enable WhatsApp article notifications to members.
# WHATSAPP_TOKEN=EAAG... (Meta WhatsApp access token)
# WHATSAPP_PHONE_ID=1234567890 (Meta WhatsApp phone number ID)

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ── Node ──────────────────────────────────────────────────────────
NODE_ENV=development
